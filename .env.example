# Copy this file to .env and replace every value prefixed with "change-me".
POSTGRES_VERSION=17.10-alpine3.23
POSTGRES_USER=tcm_admin
POSTGRES_PASSWORD=change-me-use-a-long-random-password

N8N_VERSION=2.32.6
N8N_PORT=5678
N8N_ENCRYPTION_KEY=change-me-use-at-least-32-random-characters
N8N_EXECUTIONS_DATA_MAX_AGE_HOURS=336
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

TZ=Europe/Paris
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M

