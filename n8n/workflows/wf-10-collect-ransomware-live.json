        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const responses = $input.all().map((item) => item.json);\nif (responses.length !== 1) {\n  throw new Error(`Expected one HTTP response, received ${responses.length}`);\n}\n\nconst response = responses[0];\nif (response.statusCode !== 200) {\n  throw new Error(`Unexpected HTTP status: ${response.statusCode}`);\n}\n\nconst contentType = String(response.headers?.['content-type'] ?? response.headers?.['Content-Type'] ?? '');\nif (!contentType.toLowerCase().includes('application/json')) {\n  throw new Error('Unexpected response content type');\n}\n\nconst records = response.body;\nif (!Array.isArray(records) || records.length < 1 || records.length > 500) {\n  throw new Error('Response must contain between 1 and 500 records');\n}\n\nconst requiredStringFields = ['victim', 'group', 'discovered'];\nconst allowedFields = ['activity', 'attackdate', 'claim_url', 'country', 'description', 'discovered', 'domain', 'group', 'url', 'victim'];\nconst normalized = records.map((record, index) => {\n  if (!record || typeof record !== 'object' || Array.isArray(record)) {\n    throw new Error(`Record ${index + 1} must be an object`);\n  }\n  for (const field of requiredStringFields) {\n    if (typeof record[field] !== 'string' || !record[field].trim()) {\n      throw new Error(`Record ${index + 1} has invalid ${field}`);\n    }\n  }\n  const safe = {};\n  for (const field of allowedFields) {\n    const value = record[field];\n    if (value === undefined || value === null) {\n      safe[field] = '';\n    } else if (typeof value === 'string') {\n      safe[field] = value.trim();\n    } else {\n      throw new Error(`Record ${index + 1} has invalid ${field}`);\n    }\n  }\n  return safe;\n});\n\nreturn [{ json: { records: normalized } }];"
      },
