    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all().map((item) => item.json);\nif (items.length < 1 || items.length > 200) {\n  throw new Error('RSS feed must contain between 1 and 200 items');\n}\n\nconst seenGuids = new Set();\nconst permalinkPattern = /^https:\\/\\/(?:www\\.)?frenchbreaches\\.com\\/[^\\s\\\\\\u0000-\\u001f\\u007f]*$/i;\nconst normalized = items.map((item, index) => {\n  if (!item || typeof item !== 'object' || Array.isArray(item)) {\n    throw new Error(`Item ${index + 1} must be an object`);\n  }\n\n  for (const field of ['title', 'guid', 'link', 'pubDate']) {\n    if (typeof item[field] !== 'string' || !item[field].trim()) {\n      throw new Error(`Item ${index + 1} has invalid ${field}`);\n    }\n  }\n\n  const title = item.title.trim();\n  const guid = item.guid.trim();\n  const link = item.link.trim();\n  if (title.length > 200 || guid.length > 1000 || link.length > 1000) {\n    throw new Error(`Item ${index + 1} exceeds a field limit`);\n  }\n  if (/[\\u0000-\\u001f\\u007f]/.test(title)) {\n    throw new Error(`Item ${index + 1} title contains a control character`);\n  }\n  if (guid !== link) {\n    throw new Error(`Item ${index + 1} GUID must equal its permalink`);\n  }\n  if (!permalinkPattern.test(link)) {\n    throw new Error(`Item ${index + 1} has an invalid permalink`);\n  }\n\n  const parsedDate = new Date(item.pubDate);\n  const earliest = Date.UTC(2000, 0, 1);\n  const latest = Date.now() + 86400000;\n  if (!Number.isFinite(parsedDate.getTime()) || parsedDate.getTime() < earliest || parsedDate.getTime() > latest) {\n    throw new Error(`Item ${index + 1} has an invalid publication date`);\n  }\n  if (seenGuids.has(guid)) {\n    throw new Error(`Item ${index + 1} duplicates a GUID`);\n  }\n  seenGuids.add(guid);\n\n  return { title, guid, link, published_at: parsedDate.toISOString() };\n});\n\nreturn [{ json: { records: normalized } }];"
      },
